{
  "name": "jtcc-group-e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "build": "tsc -b && vite build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test app.spec.ts",
    "test:ux": "node scripts/check-ux-review.mjs && playwright test ux.spec.ts",
    "ux:digest": "node scripts/check-ux-review.mjs --digest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "verify": "pnpm check && pnpm test:e2e && pnpm test:ux",
    "preview": "vite preview",
    "qr": "node scripts/create-qr.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "jsqr": "1.4.0",
    "oxlint": "^1.81.0",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
